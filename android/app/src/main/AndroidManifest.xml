<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Playback keeps running while the app is backgrounded. The media type
	     is only enforced from API 34, but declaring it always is harmless. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

	<!-- Pinned downloads run as a foreground service so they are not deferred
	     while the user is waiting for them, and hold a wake lock so a screen
	     that goes off does not stall an album mid-download. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!-- Only exists from API 33; on older releases the notification is posted
	     without asking. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- For the cast bridge's WifiLock, which stops Wi-Fi power saving stalling
	     the relay once the screen goes off. Discovery needs nothing: NsdManager
	     works off ACCESS_NETWORK_STATE, declared above. -->
	<uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

	<!-- Self-hosted servers are commonly plain HTTP on a LAN, so cleartext is
	     permitted. See network_security_config.xml. -->
	<application
		android:name=".GainDriveApplication"
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:networkSecurityConfig="@xml/network_security_config"
		android:supportsRtl="true"
		android:theme="@style/Theme.GainDrive">

		<!--
			singleTop, not singleTask. A share sheet launches its target with
			FLAG_ACTIVITY_NEW_TASK, which with the default `standard` mode
			stacks a *second* MainActivity on the app's existing task — two
			NavHosts, two of every activity-scoped view model, and two player
			connections bound to the same session. singleTop delivers the
			intent to the instance that exists instead, because this is the
			only activity and is therefore always its task's top.

			singleTask would also fix that, and costs more than it is worth
			here: it rules out multi-window for good and adds task-clearing
			semantics that mean nothing to a single-activity app.
		-->
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:launchMode="singleTop"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
			android:theme="@style/Theme.GainDrive">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!--
				Sharing a URL to gaindrive: the server fetches it into the
				account's own uploads. text/plain only — the shared text is
				searched for a link rather than required to be one, since a
				share is usually a title and then the URL.
			-->
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
		</activity>

		<!-- Exported so the system media controls, Bluetooth and any other
		     media browser can bind to the session. -->
		<service
			android:name=".playback.PlaybackService"
			android:exported="true"
			android:foregroundServiceType="mediaPlayback">
			<intent-filter>
				<action android:name="androidx.media3.session.MediaLibraryService" />
				<action android:name="android.media.browse.MediaBrowserService" />
			</intent-filter>
		</service>

		<!-- Not exported: only this app ever enqueues a download. The intent
		     filter is the one Media3's DownloadService sends to itself. -->
		<service
			android:name=".playback.MediaDownloadService"
			android:exported="false"
			android:foregroundServiceType="dataSync">
			<intent-filter>
				<action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</service>

	</application>

</manifest>
