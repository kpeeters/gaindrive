<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Playback keeps running while the app is backgrounded. The media type
	     is only enforced from API 34, but declaring it always is harmless. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

	<!-- Only exists from API 33; on older releases the notification is posted
	     without asking. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Self-hosted servers are commonly plain HTTP on a LAN, so cleartext is
	     permitted. See network_security_config.xml. -->
	<application
		android:name=".GainDriveApplication"
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:networkSecurityConfig="@xml/network_security_config"
		android:supportsRtl="true"
		android:theme="@style/Theme.GainDrive">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
			android:theme="@style/Theme.GainDrive">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!-- Phase 3. Declared now so the manifest shape is settled; the class
		     does not exist yet and this block stays commented until it does.
		<service
			android:name=".playback.PlaybackService"
			android:exported="true"
			android:foregroundServiceType="mediaPlayback">
			<intent-filter>
				<action android:name="androidx.media3.session.MediaSessionService" />
			</intent-filter>
		</service>
		-->

	</application>

</manifest>
