# Convenience targets for the Android client. The server itself is built with
# CMake — see CLAUDE.md.

ANDROID  := ./
GRADLEW  := ./gradlew
APK      := $(ANDROID)/app/build/outputs/apk/release/app-release.apk
BUNDLE   := $(ANDROID)/app/build/outputs/bundle/release/app-release.aab

# Which Play track `publish` uploads to. internal is the default in
# app/build.gradle.kts too; overriding here passes --track through to the
# Gradle task, e.g. `make publish TRACK=beta`.
TRACK    := internal

# Where the release signing configuration comes from. Either of these being
# present is what makes the release build use the upload key rather than the
# debug key, so it is also the test for "can this machine publish at all".
KEYPROPS := keystore.properties

# Generated by `make keystore`, and never committed — see .gitignore. .p12
# because that is what it is: keytool has defaulted to PKCS12 since Java 9 and
# produces one whatever the file is called, so a .jks name would be a lie.
KEYSTORE := $(HOME)/.gaindrive-upload.p12
KEYALIAS := upload

.PHONY: help install-device bundle publish keystore

help:
	@echo "Targets:"
	@echo "  install-device   Build the release APK and install it on the"
	@echo "                   USB-connected device."
	@echo "  bundle           Build the signed release App Bundle (.aab)."
	@echo "  publish          Build it and upload it to Google Play."
	@echo "                   Override the track with TRACK=beta."
	@echo "  keystore         Generate the upload keystore, once, and write"
	@echo "                   $(KEYPROPS) pointing at it."
	@echo ""
	@echo "Publishing needs, one time: an upload keystore (make keystore), a"
	@echo "Play service-account key as play-credentials.json or in"
	@echo "ANDROID_PUBLISHER_CREDENTIALS, and a first version uploaded through"
	@echo "the Play Console by hand — the API cannot register a new app."
	@echo "Each release needs 'build' bumped in the VERSION file at the"
	@echo "repository root; Play refuses a version code it has already seen."
	@echo "versionCode and versionName are derived from it \(see CLAUDE.md\)."

# Two steps rather than `gradlew installRelease`: that task installs to every
# attached target, so an emulator running alongside the phone would get it too
# (or the build would fail for the ambiguity). `adb -d` means specifically the
# one device on USB.
#
# -r reinstalls over the existing app, keeping its data. That works because both
# variants share an application id and are signed with the same debug key.
install-device:
	$(GRADLEW) assembleRelease
	adb -d install -r $(APK)

bundle:
	$(GRADLEW) bundleRelease
	@echo "Built $(BUNDLE)"

# The keystore check is here rather than left to Play. Without it the release
# build falls back to the debug key, which Play rejects — after a full R8 run
# and a multi-megabyte upload, with an error about the certificate that reads
# as a signing problem rather than as a missing configuration.
#
# publishReleaseBundle builds the bundle itself, so this does not depend on the
# bundle target; letting Gradle own the whole graph is what keeps the artifact
# it uploads the one it just built.
publish:
	@test -f $(KEYPROPS) -o -n "$$GAINDRIVE_KEYSTORE" || { \
	  echo "No $(KEYPROPS) and no GAINDRIVE_KEYSTORE: the release build would"; \
	  echo "be signed with the debug key and Play would reject it."; \
	  echo "Run 'make keystore' first."; exit 1; }
	@test -f play-credentials.json -o -n "$$ANDROID_PUBLISHER_CREDENTIALS" || { \
	  echo "No play-credentials.json and no ANDROID_PUBLISHER_CREDENTIALS:"; \
	  echo "nothing to authenticate to Google Play with."; exit 1; }
	$(GRADLEW) publishReleaseBundle --track $(TRACK)

# Refuses to overwrite: the upload key is unrecoverable and an app enrolled in
# Play App Signing cannot be updated once its upload key is lost without asking
# Google to reset it. RSA 4096 and 10000 days because Play requires a key valid
# past 22 October 2033.
#
# keytool asks for exactly one password, because a PKCS12 keystore has no
# separate per-key password. So keystore.properties carries only storePassword.
keystore:
	@test ! -f $(KEYSTORE) || { \
	  echo "$(KEYSTORE) already exists; refusing to overwrite it."; exit 1; }
	keytool -genkeypair -v -keystore $(KEYSTORE) -alias $(KEYALIAS) \
	  -keyalg RSA -keysize 4096 -validity 10000
	@printf 'storeFile=%s\nkeyAlias=%s\n' "$(KEYSTORE)" "$(KEYALIAS)" > $(KEYPROPS)
	@echo ""
	@echo "Wrote $(KEYPROPS). Add the password you just chose to it:"
	@echo "  storePassword=..."
	@echo "Back $(KEYSTORE) up somewhere durable — losing it means losing the"
	@echo "ability to update the app."
