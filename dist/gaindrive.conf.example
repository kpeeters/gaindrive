{
	"host": "127.0.0.1",
	"port": 4040,
	"db_path": "/var/lib/gaindrive/gaindrive.db",
	"user_db_path": "/var/lib/gaindrive/gaindrive-client.db",
	"//trusted_proxies": "Peers whose X-Forwarded-For header may be believed. Defaults to loopback, which is right when a reverse proxy on this machine terminates TLS -- the normal public deployment. It matters beyond the log: the failed-login throttle keys on the resulting address, so believing the header from an untrusted peer lets a caller pick its own rate-limit bucket and so have no rate limit at all. Set it only if the proxy is on another host, and name that host. Omit this key to keep the loopback default.",
	"trusted_proxies": [ "127.0.0.1", "::1" ],
	"//roots": "One entry per library root. 'name' is stored as the first component of every path in the database, so it is permanent: renaming a root detaches everything under it. Type is artists, categories or uploads (at most one uploads root; omit it to disable personal uploads).",
	"roots": [
		{ "name": "music",    "type": "artists",    "path": "/srv/music" },
		{ "name": "movies",   "type": "categories", "path": "/srv/movies" },
		{ "name": "personal", "type": "uploads",    "path": "/var/lib/gaindrive/uploads" }
	],
	"//cast_devices": "Chromecasts to offer even though mDNS discovery cannot find them, which happens when a device stops announcing itself or the access point drops multicast. Address must be an IP, not a hostname; port defaults to 8009 and name to the address. Devices that discovery does find need no entry here, and one listed that is also discovered is shown once. Omit this entirely to rely on discovery alone.",
	"cast_devices": [
		{ "name": "Living room", "address": "192.168.1.42" }
	],
	"//url_handlers": "Which pasted URLs may be fetched into a personal folder, and what is run for each. 'match' is a regular expression matched against the WHOLE URL, and it is the security boundary: a URL matching nothing is refused, so a pattern of .* makes this server an open outbound fetcher for every account allowed to upload. %URL% and %DIR% are substituted as whole arguments; there is no shell. Pin the output extension (--audio-format, --merge-output-format) or a song will eventually be filed as a video, and write two directories deep or the result cannot be promoted. Omit this key entirely to use the built-in yt-dlp table; give an empty list to disable the feature. Check an entry with --url-fetch-test.",
	"//url_handlers_example": "The entry below is deliberately minimal and is NOT the built-in table: it leaves out the --replace-in-metadata and --parse-metadata flags that turn a title like 'Eric Clapton - I Shot The Sheriff (Live at Budokan 2009)' into an artist, an album and a track, so with this entry a music video is filed under the channel that posted it. Run 'gaindrive --url-fetch-test <url>' to print the full built-in command lines and start from those instead of from this. Delete this key entirely to use the built-in table unchanged.",
	"url_handlers": [
		{ "name": "yt-dlp",
		  "match": "https?://(www\\.)?(youtube\\.com|youtu\\.be)/.*",
		  "audio": ["yt-dlp", "--newline", "--progress", "--no-playlist", "-x", "--audio-format", "opus", "--embed-metadata", "-P", "%DIR%", "-o", "%(artist,uploader)s/%(album,title)s/%(title)s.%(ext)s", "--", "%URL%"],
		  "video": ["yt-dlp", "--newline", "--progress", "--no-playlist", "--merge-output-format", "mp4", "--embed-metadata", "-P", "%DIR%", "-o", "%(uploader)s/%(title)s/%(title)s.%(ext)s", "--", "%URL%"] }
	],
	"url_fetch_timeout": 7200,
	"upload_dir": "/tmp/gaindrive-uploads",
	"flat_multi_disc": true,
	"transcode_cache_dir": "/var/lib/gaindrive/transcodes",
	"//transcode_cache_mb": "Raise this if you cast films to a speaker or an amplifier. Such a receiver is sent the film's soundtrack, and where that has to be re-encoded it is re-encoded losslessly -- roughly 600-800 MB for a 90-minute film -- so one of them very nearly fills the 1024 MB default and a second evicts the first. Nothing breaks; the conversion is simply paid again next time.",
	"transcode_cache_mb": 1024,
	"transcode_jobs": 0,
	"scan_jobs": 0
}
