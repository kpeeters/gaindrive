<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@GD_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>GainDrive</name>
  <summary>Play music from a GainDrive or Subsonic server</summary>
  <developer id="org.gaindrive">
    <name>Kasper Peeters</name>
  </developer>
  <description>
    <p>
      A desktop player for GainDrive and other Subsonic-compatible music
      servers.
    </p>
  </description>
  <launchable type="desktop-id">@GD_APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/kpeeters/gaindrive</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@PROJECT_VERSION@" date="@GD_RELEASE_DATE@"/>
  </releases>
</component>
