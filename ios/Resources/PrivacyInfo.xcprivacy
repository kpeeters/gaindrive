<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The app collects nothing and contacts no service other than the user's own
	GainDrive server, so all three collection keys are empty and stay that way.

	NSPrivacyAccessedAPITypes is the part that will grow. The cache phase
	(PLAN.md phase 5) adds two entries: file timestamps (C617.1) for the LRU
	eviction, and disk space (E174.1) for the usage readout and the cap check.
	Storing settings in UserDefaults adds CA92.1. Each is a one-line addition
	here; the point of writing the file now is that it is never a discovery.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
