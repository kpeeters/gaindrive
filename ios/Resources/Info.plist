<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Hand-written rather than synthesised by Xcode, because the transport
	security and local-network keys below want their reasoning next to them and
	a stable diff. See PLAN.md, "App Store constraints".
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GainDrive</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The system launch screen. An empty dictionary is the modern
	     replacement for a storyboard and is what a SwiftUI app wants. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- Upside-down is omitted on the phone (the platform convention); the
	     landscape orientations are kept because video, phase 6, needs them. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- `audio` only. Anything else is a review risk for no benefit while the
	     app merely plays music. Note that this mode does not keep the app
	     alive while casting, since the phone is then not playing audio —
	     see PLAN.md, phase 7, and ios/CAST.md for what that costs. Nothing in
	     the cast work adds a mode here: a direct cast keeps playing when the
	     app is suspended, because the receiver pulls from the server itself. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- GainDrive servers are commonly plain HTTP at a LAN address with a
	     port (http://192.0.2.9:4040) or reached over WireGuard at a private
	     address. NSAllowsLocalNetworking alone does not cover a bare private
	     IPv4 address, which is the common case, so arbitrary loads are
	     required. The app has no first-party endpoint to pin: the only server
	     it ever contacts is one the user runs themselves, at an address only
	     they know. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Denial of this permission is a state to explain, not to time out on:
	     a LAN server with the permission refused must say so rather than
	     report itself unreachable, and Settings > Casting says so rather than
	     showing an empty list. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>GainDrive connects to your own music server and finds Cast receivers on your local network.</string>

	<!-- Browsing for Cast receivers. The string must match
	     CastDiscovery.serviceType exactly: a browser for a service not listed
	     here finds nothing and reports no error, which is indistinguishable
	     from a network with no receivers on it.

	     Note this is all that Bonjour discovery needs. The restricted
	     com.apple.developer.networking.multicast entitlement — which requires a
	     written request to Apple and is often refused — covers *raw* multicast,
	     NWConnectionGroup or a socket joining a group by hand. NWBrowser goes
	     through the system's mDNSResponder, which does the multicast on the
	     app's behalf. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
	</array>

	<!-- The app uses only the standard HTTPS and cryptography the system
	     provides, which is exempt. Declaring it here answers the export
	     compliance question once instead of at every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
